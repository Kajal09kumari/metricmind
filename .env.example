# MetricMind Environment Configuration

# Optional: LLM Provider ('mock' | 'openai' | 'anthropic' | 'gemini')
# Defaults to 'mock' if not specified, which runs full deterministic analytical intelligence locally.
LLM_PROVIDER=mock
OPENAI_API_KEY=
LLM_MODEL=gpt-4o

# Warehouse Provider ('mock' | 'snowflake' | 'databricks')
# Defaults to 'mock' (in-memory relational sales warehouse with seeded corporate data).
WAREHOUSE_PROVIDER=mock

# Snowflake Configuration (Optional)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=

# Databricks Configuration (Optional)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# Governance Limits
MAX_AGENT_STEPS=8
MAX_QUERIES_PER_QUESTION=5
MAX_ROWS_RETURNED=5000
MAX_QUERY_EXECUTION_TIME_MS=10000
